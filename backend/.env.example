# 复制为同目录的.env后在本地填写。示例不创建数据库、账号或表。
# 真实.env已由项目.gitignore排除；不要把真实凭据提交Git或发到聊天中。
SMRBS_DB_HOST=127.0.0.1
SMRBS_DB_PORT=3306
# 本机开发使用项目专用数据库和账号；其他电脑需要先建立对应资源。
SMRBS_DB_NAME=smrbs_dev
SMRBS_DB_USER=smrbs_app
# 密码留空时，应用仍可启动，数据库健康检查返回503/not_configured。
# 建议用单引号包住密码；不要填写占位词。密码内容以本地真实配置为准。
SMRBS_DB_PASSWORD=
